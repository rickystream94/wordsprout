VITE_APP_ENV=local
# VITE_ENTRA_CLIENT_ID=
# VITE_REDIRECT_URI=

# ─── Learning score decay constants ───────────────────────────────────────────
# Grace period before decay begins. When set, overrides the per-score tier table
# (useful for local testing, e.g. VITE_DECAY_GRACE_DAYS=0).
# When unset (default), the tier table is used: Dormant=3d, Sprouting=5d,
# Echoing=7d, Inscribed=14d, Engraved=21d.
# VITE_DECAY_GRACE_DAYS=7

# Points are lost at a rate of 1 point per VITE_DECAY_RATE_DAYS days of inactivity
# after the grace period expires.
# Production default: 3. Override locally to test rapid decay.
# Example: VITE_DECAY_RATE_DAYS=1
VITE_DECAY_RATE_DAYS=3

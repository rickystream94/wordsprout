{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "typeRoots": ["../api/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["*.ts", "seed-data/**/*.ts"]
}
